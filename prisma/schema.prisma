// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application roles enum
enum Role {
  STUDENT
  DEPT_ADMIN
  SUPER_ADMIN
}

// Skill type enum
enum SkillType {
  TECHNICAL
  SOFT
}

// Core user model - mirrored from Clerk
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departmentAdmin DepartmentAdmin?
  student         Student?

  @@index([clerkId])
  @@index([email])
}

// Department model - represents academic departments
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admins   DepartmentAdmin[]
  students Student[]

  @@index([code])
}

// Department Admin model - links DEPT_ADMIN users to departments
model DepartmentAdmin {
  id           String     @id @default(cuid())
  userId       String     @unique
  departmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ============================================================================
// 02B — STUDENT CORE DATA MODEL
// ============================================================================

// Student model - represents a student in the placement system
model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  departmentId String
  rollNumber   String   @unique
  name         String
  phoneNumber  String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academic        StudentAcademic?
  preferences     StudentPreferences?
  skills          StudentSkill[]
  projects        StudentProject[]
  experiences     StudentExperience[]
  certifications  StudentCertification[]

  @@index([userId])
  @@index([departmentId])
  @@index([rollNumber])
}

// ============================================================================
// 02C — STUDENT PROFILE STRUCTURE
// ============================================================================

// StudentAcademic - stores academic information (one-to-one with Student)
model StudentAcademic {
  id                String   @id @default(cuid())
  studentId         String   @unique
  tenthPercentage   Float
  twelfthPercentage Float
  currentCGPA       Float
  currentSemester   Int
  activeBacklogs    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentSkill - stores skills (many-to-one with Student)
model StudentSkill {
  id        String    @id @default(cuid())
  studentId String
  skillName String
  skillType SkillType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
  @@index([studentId])
}

// StudentProject - stores projects (many-to-one with Student)
model StudentProject {
  id               String    @id @default(cuid())
  studentId        String
  title            String
  description      String    @db.Text
  technologiesUsed String    @db.Text
  projectUrl       String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentExperience - stores work experience/internships (many-to-one with Student)
model StudentExperience {
  id          String    @id @default(cuid())
  studentId   String
  companyName String
  role        String
  description String    @db.Text
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentCertification - stores certifications (many-to-one with Student)
model StudentCertification {
  id                   String    @id @default(cuid())
  studentId            String
  certificationName    String
  issuingOrganization  String
  issueDate            DateTime
  expiryDate           DateTime?
  credentialUrl        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentPreferences - stores placement preferences (one-to-one with Student)
model StudentPreferences {
  id                     String   @id @default(cuid())
  studentId              String   @unique
  preferredRoles         String   @db.Text // JSON array stored as text
  preferredLocations     String   @db.Text // JSON array stored as text
  preferredCompanyTypes  String   @db.Text // JSON array stored as text
  expectedPackageMin     Float?
  expectedPackageMax     Float?
  willingToRelocate      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
