// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application roles enum
enum Role {
  STUDENT
  DEPT_ADMIN
  SUPER_ADMIN
}

// Skill type enum
enum SkillType {
  TECHNICAL
  SOFT
}

// How a student entered the degree programme.
//
// REGULAR students complete 12th and start at semester 1. DIPLOMA students
// complete a diploma instead of 12th and are admitted laterally into the
// second year, so they have no 12th record and no semester 1/2 marks.
enum EntryType {
  REGULAR
  DIPLOMA
}

// Outcome of a self-registration request that could not be matched against
// an admin-imported student record.
enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Apply method enum for drives
enum ApplyMethod {
  IN_APP
  EXTERNAL
}

// Selection stage an application has reached.
// Advanced by department admins as the drive progresses.
enum ApplicationStage {
  APPLIED
  APTITUDE
  INTERVIEW
  OFFER
}

// Outcome of an application, independent of the stage it reached.
enum ApplicationStatus {
  IN_PROGRESS
  SELECTED
  REJECTED
  WITHDRAWN
}

// Core user model - mirrored from Clerk
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  // Display name mirrored from Clerk. Nullable because a Student's name is
  // owned by the Student record and a webhook-created user may arrive before
  // a name is known.
  name      String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departmentAdmin  DepartmentAdmin?
  student          Student?
  auditLogs        AuditLog[]
  notifications    Notification[]
  createdDrives    Drive[]                @relation("DriveCreatedBy")
  stageUpdates     DriveApplication[]     @relation("ApplicationStageUpdatedBy")
  accessRequest    StudentAccessRequest?
  reviewedRequests StudentAccessRequest[] @relation("AccessRequestReviewedBy")

  @@index([clerkId])
  @@index([email])
}

// Department model - represents academic departments
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admins         DepartmentAdmin[]
  students       Student[]
  drives         Drive[]
  driveConfigs   DriveDepartmentConfig[]
  accessRequests StudentAccessRequest[]

  @@index([code])
}

// Department Admin model - links DEPT_ADMIN users to departments
model DepartmentAdmin {
  id           String   @id @default(cuid())
  userId       String   @unique
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ============================================================================
// 02B — STUDENT CORE DATA MODEL
// ============================================================================

// Student model - represents a student in the placement system
model Student {
  id              String    @id @default(cuid())
  userId          String?   @unique // Optional: null for bulk-imported pending students
  departmentId    String
  // Null only until the student supplies it. A lateral-entry student may not
  // have been issued one at registration; they are blocked from applying to
  // any drive until it is filled in. Postgres permits many NULLs under a
  // unique index, so the constraint still holds for everyone who has one.
  rollNumber      String?   @unique
  name            String
  email           String    @unique // For matching during self-registration
  phoneNumber     String?
  isPending       Boolean   @default(true) // true until linked to User via registration
  profilePhotoUrl String?
  linkedinUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  gender          String?
  dateOfBirth     DateTime?
  address         String?   @db.Text
  personalEmail   String?
  batchYear       Int?
  // How the student entered the degree. Captured at registration, before any
  // StudentAcademic row exists, which is why it lives here rather than on the
  // academic record: it is an admission fact, not a marks fact.
  entryType       EntryType @default(REGULAR)
  // Whether the student is participating in campus placement at all.
  // A student who has opted out is excluded from placement KPIs and is not
  // offered drives. Placement itself is never stored here — it is derived
  // from a DriveApplication with status = SELECTED.
  optedIn         Boolean   @default(true)
  // Set by a department admin to freeze the opt-in choice. While locked the
  // student cannot change `optedIn` themselves; only an admin can.
  optedInLocked   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academic       StudentAcademic?
  preferences    StudentPreferences?
  skills         StudentSkill[]
  projects       StudentProject[]
  experiences    StudentExperience[]
  certifications StudentCertification[]
  applications   DriveApplication[]
  semesterMarks  SemesterMark[]

  @@index([userId])
  @@index([departmentId])
  @@index([rollNumber])
  @@index([email])
  @@index([isPending])
  @@index([optedIn])
}

// SemesterMark - per-semester SGPA records for a student
model SemesterMark {
  id           String   @id @default(cuid())
  studentId    String
  semester     Int
  sgpa         Float
  // Uploaded grade card backing this SGPA
  gradeCardUrl String?
  // Set by a department admin after checking the grade card
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
  @@index([studentId])
}

// ============================================================================
// 02C — STUDENT PROFILE STRUCTURE
// ============================================================================

// StudentAcademic - stores academic information (one-to-one with Student)
model StudentAcademic {
  id                  String   @id @default(cuid())
  studentId           String   @unique
  // Which pre-college branch is required is decided by `Student.entryType`:
  // REGULAR -> 12th, DIPLOMA -> diploma. The unused branch is left null
  // rather than zero-filled.
  tenthPercentage     Float
  tenthBoard          String?
  tenthYear           Int?
  tenthMarksheetUrl   String?
  // Null for a DIPLOMA student, who has no 12th record.
  twelfthPercentage   Float?
  twelfthBoard        String?
  twelfthYear         Int?
  twelfthMarksheetUrl String?
  // Null for a REGULAR student. Board here is the diploma awarding body
  // (e.g. MSBTE), mirroring the 10th/12th shape.
  diplomaPercentage   Float?
  diplomaBoard        String?
  diplomaYear         Int?
  diplomaMarksheetUrl String?
  currentCGPA         Float
  currentSemester     Int
  activeBacklogs      Int      @default(0)
  // Backlogs cleared in the past, kept separately from active ones
  pastBacklogCount    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentSkill - stores skills (many-to-one with Student)
model StudentSkill {
  id        String    @id @default(cuid())
  studentId String
  skillName String
  skillType SkillType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
  @@index([studentId])
}

// StudentProject - stores projects (many-to-one with Student)
model StudentProject {
  id               String    @id @default(cuid())
  studentId        String
  title            String
  description      String    @db.Text
  technologiesUsed String    @db.Text
  projectUrl       String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentExperience - stores work experience/internships (many-to-one with Student)
model StudentExperience {
  id             String    @id @default(cuid())
  studentId      String
  companyName    String
  role           String
  description    String    @db.Text
  startDate      DateTime
  endDate        DateTime?
  // Offer letter or completion certificate
  certificateUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentCertification - stores certifications (many-to-one with Student)
model StudentCertification {
  id                  String    @id @default(cuid())
  studentId           String
  certificationName   String
  issuingOrganization String
  issueDate           DateTime
  expiryDate          DateTime?
  credentialUrl       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentPreferences - stores placement preferences (one-to-one with Student)
model StudentPreferences {
  id                    String   @id @default(cuid())
  studentId             String   @unique
  preferredRoles        String   @db.Text // JSON array stored as text
  preferredLocations    String   @db.Text // JSON array stored as text
  preferredCompanyTypes String   @db.Text // JSON array stored as text
  // JSON array: On-site | Remote | Hybrid. Maps to the pre-existing "workMode" column.
  workModes             String   @default("[]") @map("workMode") @db.Text
  expectedPackageMin    Float?
  expectedPackageMax    Float?
  willingToRelocate     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ============================================================================
// 05 — DRIVE MANAGEMENT & ELIGIBILITY
// ============================================================================

// Drive model - represents a placement drive/recruitment opportunity
model Drive {
  id                  String      @id @default(cuid())
  // Null means the drive was posted centrally by a Super Admin rather than
  // owned by a single department.
  departmentId        String?
  createdByUserId     String?
  isCentralDrive      Boolean     @default(false)
  companyName         String
  roleName            String
  jobDescriptionUrl   String?
  jobDescriptionText  String?     @db.Text
  packageOffered      Float
  selectionRounds     String      @db.Text // JSON array of round names
  driveDate           DateTime
  applicationDeadline DateTime
  applyMethod         ApplyMethod
  externalApplyUrl    String?
  minCGPA             Float
  maxActiveBacklogs   Int
  eligibleDepartments String      @db.Text // JSON array of department IDs
  companyLogoUrl      String?
  packageDisplay      String?
  venue               String?
  reportingTime       String?
  contactPerson       String?
  contactPhone        String?
  pptLink             String?
  applicationFields   String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  department        Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser     User?                   @relation("DriveCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  applications      DriveApplication[]
  departmentConfigs DriveDepartmentConfig[]

  @@index([departmentId])
  @@index([applicationDeadline])
  @@index([isCentralDrive])
  @@index([createdByUserId])
}

// Per-department configuration layered over a central drive.
//
// A central drive is authored once by the Super Admin but runs separately in
// each eligible department, so venue, coordinator and required application
// fields are owned by the department admin and are visible only to students of
// that department. The Drive row itself stays untouched by department admins.
model DriveDepartmentConfig {
  id                  String   @id @default(cuid())
  driveId             String
  departmentId        String
  venue               String?
  reportingTime       String?
  coordinatorName     String?
  coordinatorPhone    String?
  coordinatorEmail    String?
  seatingAllocation   String?  @db.Text
  pptLink             String?
  specialInstructions String?  @db.Text
  applicationFields   String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  drive      Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([driveId, departmentId])
  @@index([departmentId])
}

// ============================================================================
// 06 — STUDENT APPLICATIONS
// ============================================================================

// DriveApplication model - represents a student's application to a drive
model DriveApplication {
  id                String            @id @default(cuid())
  studentId         String
  driveId           String
  appliedAt         DateTime          @default(now())
  stage             ApplicationStage  @default(APPLIED)
  status            ApplicationStatus @default(IN_PROGRESS)
  snapshotCgpa      Float?
  snapshotBacklogs  Int?
  // JSON object of the profile values the student submitted for this drive,
  // keyed by application-field key. Frozen at submission time so a later
  // profile edit never rewrites what the recruiter was shown.
  submittedDetails  String?           @db.Text
  // When the student ticked the accuracy declaration.
  consentAcceptedAt DateTime?
  // Set every time a department admin advances the stage or sets the outcome.
  // Null while the application still sits at its APPLIED / IN_PROGRESS default.
  stageUpdatedAt    DateTime?
  stageUpdatedById  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive        Drive   @relation(fields: [driveId], references: [id], onDelete: Restrict)
  stageUpdater User?   @relation("ApplicationStageUpdatedBy", fields: [stageUpdatedById], references: [id], onDelete: SetNull)

  @@unique([studentId, driveId])
  @@index([studentId])
  @@index([driveId])
  @@index([stage])
  @@index([status])
}

// ============================================================================
// 11 — SELF-REGISTRATION ACCESS REQUESTS
// ============================================================================

// A person who signed up themselves and whose details did NOT match any
// admin-imported student record.
//
// Their details are self-asserted and unverified, so they are deliberately
// NOT written into `Student` until a department admin approves them —
// otherwise an unapproved stranger would appear in the roster, in
// `totalStudents`, and in the placement-rate denominator. A sign-up whose
// email DOES match a pending imported student never reaches this table; it
// links to that record directly.
model StudentAccessRequest {
  id           String              @id @default(cuid())
  userId       String              @unique
  name         String
  email        String
  // Optional for the same reason it is on Student: a lateral-entry student
  // may not have been issued one yet.
  rollNumber   String?
  departmentId String
  phoneNumber  String
  entryType    EntryType           @default(REGULAR)
  status       AccessRequestStatus @default(PENDING)
  // Who decided, and why — a rejection should be explainable to the student.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([departmentId])
  @@index([departmentId, status])
}

// ============================================================================
// 09 — AUDIT LOGGING
// ============================================================================

// AuditLog model - immutable historical record of administrative actions
model AuditLog {
  id         String   @id @default(cuid())
  userId     String // Actor who performed the action (resolved server-side)
  action     String // Action type (CREATE, UPDATE, DELETE, ACTIVATE, DEACTIVATE, ASSIGN, UNASSIGN, APPLY, IMPORT, ROLE_CHANGE)
  entityType String // Resource type (Department, DepartmentAdmin, Drive, DriveApplication, Student, BulkImport, User)
  entityId   String? // Resource identifier (null for bulk operations)
  metadata   String?  @db.Text // Additional context as JSON
  ipAddress  String? // Client IP address (optional)
  userAgent  String? // Client user agent (optional)
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================================================
// 10 — IN-APP NOTIFICATIONS
// ============================================================================

// Notification model - in-app notifications for users
model Notification {
  id           String   @id @default(cuid())
  userId       String // Recipient (resolved server-side, never from client)
  type         String // Notification category (APPLICATION, DRIVE, PROFILE, ADMIN, SYSTEM)
  title        String // Short notification title
  message      String   @db.Text // Full notification message
  resourceType String? // Optional: type of related resource (Drive, Application, etc.)
  resourceId   String? // Optional: ID of related resource
  isRead       Boolean  @default(false) // Read/unread state
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}
