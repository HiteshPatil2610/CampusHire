// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  DEPT_ADMIN
  SUPER_ADMIN
}

// Core user model - mirrored from Clerk
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student       Student?
  departmentAdmin DepartmentAdmin?

  @@index([clerkId])
  @@index([email])
}

// Department model
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  students  Student[]
  admins    DepartmentAdmin[]
  drives    Drive[]

  @@index([code])
}

// Department Admin model
model DepartmentAdmin {
  id           String     @id @default(cuid())
  userId       String     @unique
  departmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// Student model
model Student {
  id           String     @id @default(cuid())
  userId       String     @unique
  departmentId String
  rollNumber   String     @unique
  name         String
  
  // Academic info
  cgpa         Float?
  semester     Int?
  activeBacklogs Int       @default(0)
  
  // Profile photo
  photoUrl     String?
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  applications DriveApplication[]

  @@index([departmentId])
  @@index([rollNumber])
}

// Drive model
model Drive {
  id                  String   @id @default(cuid())
  departmentId        String
  company             String
  role                String
  jobDescriptionUrl   String?
  
  // Eligibility criteria
  minCGPA             Float
  maxBacklogs         Int
  
  // Package and details
  packageAmount       String?
  selectionRounds     String?
  driveDate           DateTime?
  applicationDeadline DateTime
  
  // Apply method
  applyMethod         String   // "in-app" or "external"
  externalLink        String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  applications  DriveApplication[]

  @@index([departmentId])
  @@index([applicationDeadline])
}

// Drive Application model - unique constraint ensures one application per student per drive
model DriveApplication {
  id        String   @id @default(cuid())
  studentId String
  driveId   String
  appliedAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive   Drive   @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@unique([studentId, driveId])
  @@index([studentId])
  @@index([driveId])
}

// Audit Log model
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  performedBy String
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([performedBy])
}
