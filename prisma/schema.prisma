// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Index policy
//
// Postgres serves a query on a column from any btree index whose *leftmost*
// column it is, so an `@@index([x])` alongside `x @unique` — or alongside an
// `@@index([x, y])` — is a second copy of the same btree. It is never read,
// and every insert and update maintains it. Thirteen such duplicates were
// removed; before adding an index, check it is not already the leftmost
// column of an existing one.

// Application roles enum
enum Role {
  STUDENT
  DEPT_ADMIN
  SUPER_ADMIN
}

// Skill type enum
enum SkillType {
  TECHNICAL
  SOFT
}

// How a student entered the degree programme.
//
// REGULAR students complete 12th and start at semester 1. DIPLOMA students
// complete a diploma instead of 12th and are admitted laterally into the
// second year, so they have no 12th record and no semester 1/2 marks.
enum EntryType {
  REGULAR
  DIPLOMA
}

// Outcome of a self-registration request that could not be matched against
// an admin-imported student record.
enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Apply method enum for drives
enum ApplyMethod {
  IN_APP
  EXTERNAL
}

// Lifecycle of a master drive (the `Drive` row itself).
//
// DRAFT means the Super Admin is still composing it and assigning departments.
// Existing rows were backfilled to PUBLISHED because they are already live to
// students. Nothing gates student visibility on this yet — that lands with the
// lifecycle phase.
//
// CANCELLED means the drive was called off for every department: nobody can
// apply, nobody new sees it, and everything already recorded stays.
enum MasterDriveStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

// What a drive eligibility rule tests. Each maps to a column the Student model
// actually has — see features/drives/domain/eligibility-rules.ts for the
// column, the allowed operators and the value bounds of each.
enum EligibilityRuleType {
  CGPA
  ACTIVE_BACKLOGS
  PAST_BACKLOGS
  TENTH_PERCENTAGE
  TWELFTH_PERCENTAGE
  DIPLOMA_PERCENTAGE
  PRE_COLLEGE_PERCENTAGE
  CURRENT_SEMESTER
  BATCH_YEAR
  ENTRY_TYPE
  SKILL
}

enum EligibilityOperator {
  GTE
  LTE
  EQ
  IN
  INCLUDES_ALL
  INCLUDES_ANY
}

// Where an application field's value comes from.
//   PROFILE        the student's profile (pre-filled)
//   STUDENT_INPUT  typed by the student on the application (custom questions)
//   UPLOAD         a document the student uploaded to their profile
enum ApplicationFieldSource {
  PROFILE
  STUDENT_INPUT
  UPLOAD
}

// Whether the student may change a field's value on the application.
enum ApplicationFieldPermission {
  READ_ONLY
  EDITABLE
}

// Lifecycle of one department's instance of a drive (`DriveDepartmentConfig`).
//
// ASSIGNED   the Super Admin assigned the drive to this department; its admin
//            has not configured it yet
// CONFIGURED the department admin saved a configuration but has not published
// PUBLISHED  the department admin released it to their students
// CLOSED     administratively closed, distinct from "deadline passed", which
//            is still derived and never stored
// ARCHIVED   historical; the department is done with this drive entirely
// CANCELLED  called off in this department: no applications, hidden from
//            students who have not applied; history and snapshots are kept
enum DepartmentDriveStatus {
  ASSIGNED
  CONFIGURED
  PUBLISHED
  CLOSED
  ARCHIVED
  CANCELLED
}

// Selection stage an application has reached.
// Advanced by department admins as the drive progresses.
enum ApplicationStage {
  APPLIED
  APTITUDE
  INTERVIEW
  OFFER
}

// Outcome of an application, independent of the stage it reached.
enum ApplicationStatus {
  IN_PROGRESS
  SELECTED
  REJECTED
  WITHDRAWN
}

// Core user model - mirrored from Clerk
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  // Display name mirrored from Clerk. Nullable because a Student's name is
  // owned by the Student record and a webhook-created user may arrive before
  // a name is known.
  name      String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departmentAdmin         DepartmentAdmin?
  student                 Student?
  auditLogs               AuditLog[]
  notifications           Notification[]
  createdDrives           Drive[]                      @relation("DriveCreatedBy")
  stageUpdates            DriveApplication[]           @relation("ApplicationStageUpdatedBy")
  accessRequest           StudentAccessRequest?
  reviewedRequests        StudentAccessRequest[]       @relation("AccessRequestReviewedBy")
  publishedDrives         DriveDepartmentConfig[]      @relation("DepartmentDrivePublishedBy")
  recordedPlacements      StudentPlacement[]           @relation("PlacementRecordedBy")
  revokedPlacements       StudentPlacement[]           @relation("PlacementRevokedBy")
  pipelineVersionsCreated RecruitmentPipelineVersion[] @relation("PipelineVersionCreatedBy")
  stageEvents             ApplicationStageEvent[]      @relation("StageEventActor")
  pipelineRequests        PipelineChangeRequest[]      @relation("PipelineRequestedBy")
  pipelineReviews         PipelineChangeRequest[]      @relation("PipelineReviewedBy")
  cancelledDrives         Drive[]                      @relation("DriveCancelledBy")
  cancelledDeptDrives     DriveDepartmentConfig[]      @relation("DepartmentDriveCancelledBy")
  notificationPreference  NotificationPreference?
  adminInvitationsSent    AdminInvitation[]            @relation("InvitationInvitedBy")
  adminInvitationAccepted AdminInvitation[]            @relation("InvitationAcceptedBy")
  adminInvitationsRevoked AdminInvitation[]            @relation("InvitationRevokedBy")
  adminsDisabled          DepartmentAdmin[]            @relation("AdminDisabledBy")
  institutionSettings     InstitutionSettings[]        @relation("InstitutionSettingsUpdatedBy")
  departmentSettings      DepartmentSettings[]         @relation("DepartmentSettingsUpdatedBy")
  notificationDispatches  NotificationDispatch[]       @relation("DispatchTriggeredBy")
  announcements           Announcement[]               @relation("AnnouncementAuthor")
  archivedAnnouncements   Announcement[]               @relation("AnnouncementArchivedBy")
}

// Department model - represents academic departments
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admins                DepartmentAdmin[]
  students              Student[]
  drives                Drive[]
  driveConfigs          DriveDepartmentConfig[]
  accessRequests        StudentAccessRequest[]
  eligibleForDriveLinks DriveEligibleDepartment[]
  announcements         Announcement[]
  adminInvitations      AdminInvitation[]
  settings              DepartmentSettings?
}

// Department Admin model - links DEPT_ADMIN users to departments
model DepartmentAdmin {
  id            String                @id @default(cuid())
  userId        String                @unique
  departmentId  String
  // Whether this authorization is live. A disabled admin keeps their account,
  // their history and their audit trail, but `requireDepartmentAdmin` refuses
  // them, so every department-scoped action refuses them too.
  status        DepartmentAdminStatus @default(ACTIVE)
  disabledAt    DateTime?
  disabledById  String?
  disableReason String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  // When the admin first opened CampusHire after being made an admin - the
  // moment an invitation counts as accepted. Existing admins were backfilled
  // with createdAt, so only admins invited from now on produce the event.
  firstSeenAt   DateTime?

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  disabledBy User?      @relation("AdminDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([status])
}

// Whether a department admin's authorization is live.
enum DepartmentAdminStatus {
  ACTIVE
  DISABLED
}

// How far an invitation has got.
enum AdminInvitationStatus {
  // Sent through Clerk; the person has not signed up yet.
  INVITED
  // They signed up: a User and a DepartmentAdmin now exist.
  ACCEPTED
  // Withdrawn by a Super Admin before it was used.
  REVOKED
}

// An invitation to become a department admin.
//
// CampusHire never creates credentials: the invitation is issued through
// Clerk, which emails it and owns the sign-up. This row is the institution's
// record of who was invited, by whom, to which department, and what became of
// it. The department and role travel in the Clerk invitation's public
// metadata, so acceptance can be trusted without believing an email address.
model AdminInvitation {
  id                String                @id @default(cuid())
  email             String
  name              String
  departmentId      String
  status            AdminInvitationStatus @default(INVITED)
  // The invitation in Clerk, so it can be revoked or replaced there.
  clerkInvitationId String?               @unique
  invitedById       String
  invitedAt         DateTime              @default(now())
  resentAt          DateTime?
  resendCount       Int                   @default(0)
  acceptedAt        DateTime?
  acceptedByUserId  String?
  revokedAt         DateTime?
  revokedById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  invitedBy      User       @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedByUser User?      @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedBy      User?      @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([status, invitedAt])
  @@index([departmentId])
  @@index([email])
}

// ============================================================================
// 02B — STUDENT CORE DATA MODEL
// ============================================================================

// Student model - represents a student in the placement system
model Student {
  id              String    @id @default(cuid())
  userId          String?   @unique // Optional: null for bulk-imported pending students
  departmentId    String
  // The college's MIS number — the student's institutional identifier, and
  // the key self-registration matches on. Required at every write boundary
  // (import, manual add, registration, approval); nullable here only because
  // students created before it existed have none. `id` stays the primary
  // key: every foreign key in the schema points at it.
  misNumber       String?   @unique
  // University PRN. Optional, but never shared by two students.
  prnNumber       String?   @unique
  // Required at every write boundary since MIS identity landed; nullable only
  // for students created before that. Postgres permits many NULLs under a
  // unique index, so the constraint still holds for everyone who has one.
  rollNumber      String?   @unique
  name            String
  email           String    @unique // For matching during self-registration
  phoneNumber     String?
  isPending       Boolean   @default(true) // true until linked to User via registration
  profilePhotoUrl String?
  linkedinUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  gender          String?
  dateOfBirth     DateTime?
  address         String?   @db.Text
  personalEmail   String?
  // The year the student is expected to pass out, e.g. 2027. This is the
  // student's batch: the label "2023-27" is derived from it by
  // `batchLabel` (features/students/utils/batch.ts) and never stored.
  // Replaces the former `batchYear`, whose meaning (admission or passout)
  // was never defined.
  expectedPassoutYear Int?
  // How the student entered the degree. Captured at registration, before any
  // StudentAcademic row exists, which is why it lives here rather than on the
  // academic record: it is an admission fact, not a marks fact.
  entryType       EntryType @default(REGULAR)
  // Whether the student is participating in campus placement at all.
  // A student who has opted out is excluded from placement KPIs and is not
  // offered drives. Placement itself is never stored here — it is derived
  // from a DriveApplication with status = SELECTED.
  optedIn         Boolean   @default(true)
  // Set by a department admin to freeze the opt-in choice. While locked the
  // student cannot change `optedIn` themselves; only an admin can.
  optedInLocked   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academic       StudentAcademic?
  preferences    StudentPreferences?
  skills         StudentSkill[]
  projects       StudentProject[]
  experiences    StudentExperience[]
  certifications StudentCertification[]
  applications   DriveApplication[]
  semesterMarks  SemesterMark[]
  placements     StudentPlacement[]

  // A department's roster by batch. Also serves the plain departmentId
  // lookup (leftmost column), so no separate index is kept for it.
  @@index([departmentId, expectedPassoutYear])
  @@index([isPending])
  @@index([optedIn])
}

// SemesterMark - per-semester SGPA records for a student
model SemesterMark {
  id           String   @id @default(cuid())
  studentId    String
  semester     Int
  sgpa         Float
  // Uploaded grade card backing this SGPA
  gradeCardUrl String?
  // Set by a department admin after checking the grade card
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
}

// ============================================================================
// 02C — STUDENT PROFILE STRUCTURE
// ============================================================================

// StudentAcademic - stores academic information (one-to-one with Student)
model StudentAcademic {
  id                  String   @id @default(cuid())
  studentId           String   @unique
  // Which pre-college branch is required is decided by `Student.entryType`:
  // REGULAR -> 12th, DIPLOMA -> diploma. The unused branch is left null
  // rather than zero-filled.
  tenthPercentage     Float
  tenthBoard          String?
  tenthYear           Int?
  tenthMarksheetUrl   String?
  // Null for a DIPLOMA student, who has no 12th record.
  twelfthPercentage   Float?
  twelfthBoard        String?
  twelfthYear         Int?
  twelfthMarksheetUrl String?
  // Null for a REGULAR student. Board here is the diploma awarding body
  // (e.g. MSBTE), mirroring the 10th/12th shape.
  diplomaPercentage   Float?
  diplomaBoard        String?
  diplomaYear         Int?
  diplomaMarksheetUrl String?
  currentCGPA         Float
  currentSemester     Int
  activeBacklogs      Int      @default(0)
  // Backlogs cleared in the past, kept separately from active ones
  pastBacklogCount    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// StudentSkill - stores skills (many-to-one with Student)
model StudentSkill {
  id        String    @id @default(cuid())
  studentId String
  skillName String
  skillType SkillType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
}

// StudentProject - stores projects (many-to-one with Student)
model StudentProject {
  id               String    @id @default(cuid())
  studentId        String
  title            String
  description      String    @db.Text
  technologiesUsed String    @db.Text
  projectUrl       String?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentExperience - stores work experience/internships (many-to-one with Student)
model StudentExperience {
  id             String    @id @default(cuid())
  studentId      String
  companyName    String
  role           String
  description    String    @db.Text
  startDate      DateTime
  endDate        DateTime?
  // Offer letter or completion certificate
  certificateUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentCertification - stores certifications (many-to-one with Student)
model StudentCertification {
  id                  String    @id @default(cuid())
  studentId           String
  certificationName   String
  issuingOrganization String
  issueDate           DateTime
  expiryDate          DateTime?
  credentialUrl       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// StudentPreferences - stores placement preferences (one-to-one with Student)
model StudentPreferences {
  id                    String   @id @default(cuid())
  studentId             String   @unique
  preferredRoles        String   @db.Text // JSON array stored as text
  preferredLocations    String   @db.Text // JSON array stored as text
  preferredCompanyTypes String   @db.Text // JSON array stored as text
  // JSON array: On-site | Remote | Hybrid. Maps to the pre-existing "workMode" column.
  workModes             String   @default("[]") @map("workMode") @db.Text
  expectedPackageMin    Float?
  expectedPackageMax    Float?
  willingToRelocate     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 05 — DRIVE MANAGEMENT & ELIGIBILITY
// ============================================================================

// Drive model - represents a placement drive/recruitment opportunity
model Drive {
  id                       String            @id @default(cuid())
  // Null means the drive was posted centrally by a Super Admin rather than
  // owned by a single department.
  departmentId             String?
  createdByUserId          String?
  isCentralDrive           Boolean           @default(false)
  companyName              String
  roleName                 String
  jobDescriptionUrl        String?
  jobDescriptionText       String?           @db.Text
  // Institution-level defaults a department instance may override. Plain text
  // for requirements; skills are a JSON array of tags, matching
  // `selectionRounds`.
  requirements             String?           @db.Text
  skills                   String?           @db.Text
  // Money, so NUMERIC rather than Float: exact storage and exact SQL
  // aggregation. Prisma surfaces this as a Decimal, which is not a number —
  // see features/drives/utils/format-package.ts before reading it.
  packageOffered           Decimal           @db.Decimal(10, 2)
  selectionRounds          String            @db.Text // JSON array of round names
  driveDate                DateTime
  applicationDeadline      DateTime
  applyMethod              ApplyMethod
  externalApplyUrl         String?
  minCGPA                  Float
  maxActiveBacklogs        Int
  companyLogoUrl           String?
  packageDisplay           String?
  venue                    String?
  reportingTime            String?
  contactPerson            String?
  contactPhone             String?
  pptLink                  String?
  applicationFields        String?           @db.Text
  // Master-drive lifecycle. Defaults to PUBLISHED so every pre-existing drive
  // keeps behaving exactly as before; a newly created central drive starts as
  // DRAFT and is released per department.
  lifecycleStatus          MasterDriveStatus @default(PUBLISHED)
  // Which master content fields a department admin may override for their
  // department (see DEPARTMENT_EDITABLE_FIELDS). Anything not listed is
  // locked to the master's value. Set by the Super Admin only; a CHECK keeps
  // it to known field keys.
  departmentEditableFields String[]          @default([])
  // The master recruitment pipeline: the stages every department drive
  // starts from, as a JSON array of stage definitions (TEXT, as every JSON
  // column here). NULL means "built from selectionRounds".
  masterPipeline           String?           @db.Text
  cancelledAt              DateTime?
  cancelledById            String?
  cancellationReason       String?           @db.Text
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  // Relations
  department              Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser           User?                     @relation("DriveCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledBy             User?                     @relation("DriveCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  applications            DriveApplication[]
  departmentConfigs       DriveDepartmentConfig[]
  eligibleDepartmentLinks DriveEligibleDepartment[]
  // Master default eligibility rules, inherited by every department instance
  // that does not set a rule of the same type itself.
  eligibilityRules        DriveEligibilityRule[]
  // Master default application form, used by any department instance that has
  // no form of its own. A department-owned drive's form lives here.
  formFields              DriveApplicationField[]
  placements              StudentPlacement[]

  @@index([departmentId])
  @@index([applicationDeadline])
  @@index([isCentralDrive])
  @@index([createdByUserId])
}

// Which departments a drive is open to, as real rows instead of a JSON array
// in `Drive.eligibleDepartments` (kept, for now, as the read/write paths are
// switched over to this table; see DriveEligibleDepartment migration notes).
// Referential integrity means a deleted department can no longer leave a
// dangling ID sitting in a drive's eligibility list, and membership is an
// indexed FK lookup instead of a text substring scan.
model DriveEligibleDepartment {
  id           String   @id @default(cuid())
  driveId      String
  departmentId String
  createdAt    DateTime @default(now())

  drive      Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([driveId, departmentId])
  @@index([departmentId])
}

// The DEPARTMENT DRIVE instance: one department's run of a master drive.
//
// A central drive is authored once by the Super Admin but runs separately in
// each assigned department, so venue, coordinator and required application
// fields are owned by the department admin and are visible only to students of
// that department. The Drive row itself stays untouched by department admins.
//
// A row here is created by the assignment operation, together with the
// matching `DriveEligibleDepartment` row, inside one transaction — the two are
// the same fact (this drive runs in this department) recorded at two levels,
// and must never exist without each other.
model DriveDepartmentConfig {
  id                 String                @id @default(cuid())
  driveId            String
  departmentId       String
  // Where this department's instance sits in its own lifecycle. Student
  // visibility is gated on PUBLISHED; "deadline passed" remains a separate,
  // derived open/closed state and is never stored.
  status             DepartmentDriveStatus @default(ASSIGNED)
  // When the Super Admin assigned the drive to this department.
  assignedAt         DateTime              @default(now())
  // Set once, when the department admin releases the drive to their students.
  publishedAt        DateTime?
  publishedByUserId  String?
  // Set at the same moment as publishedAt. Its presence is what makes the
  // content fields immutable — a published drive is something students have
  // already read and applied against.
  lockedAt           DateTime?
  // Set when the instance is cancelled, by whom and why.
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?               @db.Text

  // Department overrides of the master drive's content. NULL means "inherit
  // from the master" — the master row is never duplicated per department, and
  // a value is only stored here when this department deliberately differs.
  // Resolved at read time by `resolveDepartmentDrive`.
  roleName            String?
  jobDescriptionText  String?   @db.Text
  requirements        String?   @db.Text
  skills              String?   @db.Text // JSON array of tags
  driveDate           DateTime?
  applicationDeadline DateTime?
  selectionRounds     String?   @db.Text // JSON array of round names
  minCGPA             Float?
  maxActiveBacklogs   Int?
  venue               String?
  reportingTime       String?
  coordinatorName     String?
  coordinatorPhone    String?
  coordinatorEmail    String?
  seatingAllocation   String?   @db.Text
  pptLink             String?
  specialInstructions String?   @db.Text
  applicationFields   String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  drive            Drive                        @relation(fields: [driveId], references: [id], onDelete: Cascade)
  department       Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  publishedByUser  User?                        @relation("DepartmentDrivePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  cancelledBy      User?                        @relation("DepartmentDriveCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  // This department's own eligibility rules. A rule of a given type here
  // replaces the master's rules of that type for this department only.
  eligibilityRules DriveEligibilityRule[]
  // This department's application form. When present it is the whole form —
  // it replaces the master's rather than merging with it. Materialised at
  // publication so a published form never depends on anything that can change.
  formFields       DriveApplicationField[]
  pipelineVersions RecruitmentPipelineVersion[]
  pipelineRequests PipelineChangeRequest[]

  @@unique([driveId, departmentId])
  // A department admin's list is always "my department, filtered by status".
  // This supersedes the plain [departmentId] index — Postgres serves that
  // lookup from this btree's leftmost column, so keeping both would be a
  // second copy every write has to maintain (see the index policy above).
  @@index([departmentId, status])
}

// One eligibility rule, relational rather than JSON text.
//
// Owned by exactly one of:
//   - a master drive (`driveId`)                     — an institution default
//   - a department instance (`driveDepartmentConfigId`) — that department's rule
// A department rule of a given type replaces the master's rules of that type
// for that department; every other master rule is inherited.
//
// Two CHECK constraints live in the migration SQL because Prisma cannot
// express them: exactly one owner is set, and exactly one value column is set
// (`numberValue` for thresholds, `listValue` for set membership and skills).
// Operator/value-shape validity per rule type is enforced at the write
// boundary in features/drives/domain/eligibility-rule-schema.ts.
//
// The legacy `Drive.minCGPA` / `maxActiveBacklogs` columns (and their instance
// overrides) are kept and dual-written as mirrors of the CGPA and
// ACTIVE_BACKLOGS rules until they are dropped in a later phase.
model DriveEligibilityRule {
  id                      String              @id @default(cuid())
  driveId                 String?
  driveDepartmentConfigId String?
  ruleType                EligibilityRuleType
  operator                EligibilityOperator
  numberValue             Float?
  listValue               String[]            @default([])
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  drive           Drive?                 @relation(fields: [driveId], references: [id], onDelete: Cascade)
  departmentDrive DriveDepartmentConfig? @relation(fields: [driveDepartmentConfigId], references: [id], onDelete: Cascade)

  // One rule per (owner, type, operator): a semester range is GTE + LTE, but
  // never two GTEs. Each unique index also serves the owner lookup, so no
  // separate owner index is needed (see the index policy above).
  @@unique([driveId, ruleType, operator])
  @@unique([driveDepartmentConfigId, ruleType, operator])
}

// One field of an application form, relational rather than JSON text.
//
// Owned by exactly one of a master drive (its default form) or a department
// instance (that department's form). `fieldKey` is either a catalog key
// (features/drives/data/application-fields-catalog.ts) or a custom question
// `custom_<a-z0-9_>`; anything else is refused at the write boundary *and* by
// a CHECK in the migration SQL. A custom field is always STUDENT_INPUT and
// EDITABLE — also enforced by a CHECK.
//
// The legacy `applicationFields` JSON columns on Drive and
// DriveDepartmentConfig are kept and dual-written until a later phase drops
// them; reads are relational-first and fall back to them.
model DriveApplicationField {
  id                      String                     @id @default(cuid())
  driveId                 String?
  driveDepartmentConfigId String?
  fieldKey                String
  label                   String
  source                  ApplicationFieldSource
  category                String
  description             String?                    @db.Text
  isRequired              Boolean                    @default(false)
  isEnabled               Boolean                    @default(true)
  sortOrder               Int
  permission              ApplicationFieldPermission
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  drive           Drive?                 @relation(fields: [driveId], references: [id], onDelete: Cascade)
  departmentDrive DriveDepartmentConfig? @relation(fields: [driveDepartmentConfigId], references: [id], onDelete: Cascade)

  // One row per field per form. Each also serves the owner lookup.
  @@unique([driveId, fieldKey])
  @@unique([driveDepartmentConfigId, fieldKey])
}

// ============================================================================
// 06 — STUDENT APPLICATIONS
// ============================================================================

// DriveApplication model - represents a student's application to a drive
model DriveApplication {
  id                String            @id @default(cuid())
  studentId         String
  driveId           String
  appliedAt         DateTime          @default(now())
  stage             ApplicationStage  @default(APPLIED)
  status            ApplicationStatus @default(IN_PROGRESS)
  snapshotCgpa      Float?
  snapshotBacklogs  Int?
  // JSON object of the profile values the student submitted for this drive,
  // keyed by application-field key. Frozen at submission time so a later
  // profile edit never rewrites what the recruiter was shown.
  submittedDetails  String?           @db.Text
  // When the student ticked the accuracy declaration.
  consentAcceptedAt DateTime?
  // Set every time a department admin advances the stage or sets the outcome.
  // Null while the application still sits at its APPLIED / IN_PROGRESS default.
  stageUpdatedAt    DateTime?
  stageUpdatedById  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  student        Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive          Drive                     @relation(fields: [driveId], references: [id], onDelete: Restrict)
  stageUpdater   User?                     @relation("ApplicationStageUpdatedBy", fields: [stageUpdatedById], references: [id], onDelete: SetNull)
  snapshot       DriveApplicationSnapshot?
  placement      StudentPlacement?
  // The recruitment stage the application is in — a stage of the pipeline
  // version it was last moved under. Null only for applications from before
  // pipelines that the backfill has not mapped yet.
  currentStageId String?
  currentStage   RecruitmentStage?         @relation("ApplicationCurrentStage", fields: [currentStageId], references: [id], onDelete: NoAction)
  stageEvents    ApplicationStageEvent[]

  @@unique([studentId, driveId])
  @@index([driveId])
  @@index([stage])
  @@index([status])
}

// How a snapshot came to exist.
enum ApplicationSnapshotOrigin {
  // Captured by applyToDrive, in the same transaction as the application.
  SUBMISSION
  // Reconstructed for an application submitted before snapshots existed, from
  // only the columns recorded at submission time. It never claims an
  // eligibility basis, form or drive content that was not recorded.
  BACKFILL
}

// The historical record of one application: what the student submitted, and
// why they were eligible, against which form and which drive content — frozen
// at submission so it stays reproducible whatever later changes to the drive,
// its rules, its form or the student's profile.
//
// One per application, written in the same transaction as the application.
// Rows are never updated (a trigger in the migration refuses it); they go only
// with their application. `payload` is a versioned JSON document (TEXT, as
// every other JSON column in this schema), CHECKed to be a JSON object. The
// three hashes let two snapshots be compared on eligibility, form and drive
// content without parsing the payload.
model DriveApplicationSnapshot {
  id               String                    @id @default(cuid())
  applicationId    String                    @unique
  origin           ApplicationSnapshotOrigin
  schemaVersion    Int
  capturedAt       DateTime                  @default(now())
  formHash         String?
  eligibilityHash  String?
  driveContentHash String?
  payload          String                    @db.Text

  application DriveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 11 — SELF-REGISTRATION ACCESS REQUESTS
// ============================================================================

// A person who signed up themselves and whose details did NOT match any
// admin-imported student record.
//
// Their details are self-asserted and unverified, so they are deliberately
// NOT written into `Student` until a department admin approves them —
// otherwise an unapproved stranger would appear in the roster, in
// `totalStudents`, and in the placement-rate denominator. A sign-up whose
// email DOES match a pending imported student never reaches this table; it
// links to that record directly.
model StudentAccessRequest {
  id           String              @id @default(cuid())
  userId       String              @unique
  name         String
  email        String
  // Identity as the applicant typed it. Nullable only for requests made
  // before MIS-based verification; every new request carries MIS, roll
  // number and batch.
  misNumber           String?
  prnNumber           String?
  rollNumber          String?
  expectedPassoutYear Int?
  departmentId String
  phoneNumber  String
  entryType    EntryType           @default(REGULAR)
  status       AccessRequestStatus @default(PENDING)
  // Who decided, and why — a rejection should be explainable to the student.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([departmentId, status])
}

// ============================================================================
// 09 — AUDIT LOGGING
// ============================================================================

// AuditLog model - immutable historical record of administrative actions
model AuditLog {
  id         String   @id @default(cuid())
  userId     String // Actor who performed the action (resolved server-side)
  action     String // Action type (CREATE, UPDATE, DELETE, ACTIVATE, DEACTIVATE, ASSIGN, UNASSIGN, APPLY, IMPORT, ROLE_CHANGE)
  entityType String // Resource type (Department, DepartmentAdmin, Drive, DriveApplication, Student, BulkImport, User)
  entityId   String? // Resource identifier (null for bulk operations)
  metadata   String?  @db.Text // Additional context as JSON
  ipAddress  String? // Client IP address (optional)
  userAgent  String? // Client user agent (optional)
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================================================
// 10 — IN-APP NOTIFICATIONS
// ============================================================================

// How urgent a notification or announcement is. Stored, and set from the
// event registry (features/notifications/domain/events.ts) unless an
// announcement sets its own - callers never pass free text.
enum NotificationPriority {
  INFO
  SUCCESS
  ACTION_REQUIRED
  WARNING
  URGENT
}

// The notification centre's tabs.
enum NotificationCategory {
  DRIVE
  APPLICATION
  RECRUITMENT
  ANNOUNCEMENT
  SYSTEM
}

// What happened. Each value has one definition in the event registry: its
// category, default priority, which roles may receive it, and whether the
// recipient may mute it.
enum NotificationEvent {
  // Student
  DRIVE_PUBLISHED
  DRIVE_UPDATED
  DRIVE_DEADLINE
  DRIVE_CANCELLED
  APPLICATION_SUBMITTED
  APPLICATION_SHORTLISTED
  APPLICATION_TEST
  APPLICATION_INTERVIEW
  APPLICATION_STAGE_CHANGED
  APPLICATION_SELECTED
  APPLICATION_REJECTED
  PLACEMENT_RECORDED
  PLACEMENT_REVOKED
  PROFILE_INCOMPLETE
  ACCOUNT_UPDATE
  // Department admin
  DRIVE_ASSIGNED
  DRIVE_CONFIG_REMINDER
  DRIVE_READY_TO_PUBLISH
  PIPELINE_CHANGE_REVIEWED
  NEW_APPLICATIONS
  ACCESS_REQUEST
  STUDENT_UPDATE
  ADMIN_DRIVE_DEADLINE
  MASTER_DRIVE_UPDATED
  ADMIN_SYSTEM
  // Super Admin
  ADMIN_INVITED
  ADMIN_ACCEPTED_INVITATION
  DRIVE_ASSIGNMENT
  DEPARTMENT_CONFIGURED
  DEPARTMENT_DRIVE_PUBLISHED
  PIPELINE_CHANGE_REQUESTED
  APPLICATION_MILESTONE
  ACCESS_REQUEST_ESCALATED
  SYSTEM_ALERT
  // Any role
  ANNOUNCEMENT
}

// One in-app notification for one user. Written only by
// `deliverNotification` (lib/notifications.ts), which resolves the event's
// category and priority, checks the recipient's role and preferences, and
// makes a repeated event a no-op through (userId, dedupeKey).
model Notification {
  id           String               @id @default(cuid())
  userId       String // Recipient (resolved server-side, never from client)
  // Legacy coarse type (APPLICATION, DRIVE, PROFILE, ADMIN, SYSTEM), still
  // written for older readers. `category` and `event` are what the app uses.
  type         String
  event        NotificationEvent?
  category     NotificationCategory @default(SYSTEM)
  priority     NotificationPriority @default(INFO)
  title        String // Short notification title
  message      String               @db.Text // Full notification message
  resourceType String? // Optional: type of related resource (Drive, Application, etc.)
  resourceId   String? // Optional: ID of related resource
  // Where "open" goes. Always an in-app path (CHECK), built server-side for
  // the recipient's role.
  actionUrl    String?
  isRead       Boolean              @default(false) // Read/unread state
  readAt       DateTime?
  // Hidden from the recipient after this moment (a closed drive's "new
  // drive", an expired announcement).
  expiresAt    DateTime?
  // The event's identity for this recipient. The same event delivered twice
  // - a retried publish, a double-clicked action - is written once.
  dedupeKey    String?
  // The fan-out that produced it, when it came from one.
  dispatchId   String?
  createdAt    DateTime             @default(now())

  // Relations
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatch NotificationDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([userId, category, createdAt])
  @@index([createdAt])
  @@index([dispatchId])
}

enum NotificationDispatchStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

// One fan-out: an event that notifies many people (a drive published in a
// department, an announcement, a cancellation). Its key makes the fan-out run
// once; its status, attempts and last error are the delivery record, and a
// failed one can be retried by the Super Admin - the per-recipient dedupe
// keys make a retry fill only the gaps.
//
// In-app notifications are the only channel CampusHire has. SENT means the
// notification rows were written, nothing more; no email is sent.
model NotificationDispatch {
  id             String                     @id @default(cuid())
  key            String                     @unique
  event          NotificationEvent
  status         NotificationDispatchStatus @default(PENDING)
  // What a retry needs to run the fan-out again (JSON, TEXT like every JSON
  // column here). Ids only - recipients are always resolved again.
  payload        String                     @db.Text
  departmentId   String?
  triggeredById  String?
  attempts       Int                        @default(1)
  recipientCount Int                        @default(0)
  lastError      String?                    @db.Text
  completedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  triggeredBy   User?          @relation("DispatchTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([status, updatedAt])
  @@index([event])
}

// What a user has chosen not to be told. Only events the registry marks as
// optional for the user's role can be muted, and an URGENT notification is
// delivered regardless.
model NotificationPreference {
  userId      String              @id
  mutedEvents NotificationEvent[] @default([])
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 10b - ANNOUNCEMENTS
// ============================================================================

enum AnnouncementStatus {
  DRAFT
  // Published with a future publishAt; visible from then.
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  STUDENTS
  ADMINS
  EVERYONE
}

// An announcement is its own record - the notifications it generates point at
// it and are never the source of its content. Who sees it is decided by
// features/announcements/domain/announcement-audience.ts, and the same rule
// picks who is notified.
//
// departmentId NULL is institution-wide, which only the Super Admin can
// write; a department admin's announcements are always their own
// department's, and always to its students.
model Announcement {
  id             String               @id @default(cuid())
  title          String
  content        String               @db.Text
  authorId       String
  departmentId   String?
  audience       AnnouncementAudience @default(STUDENTS)
  // Narrows the students reached; empty means every batch.
  batchYears     Int[]                @default([])
  priority       NotificationPriority @default(INFO)
  status         AnnouncementStatus   @default(DRAFT)
  publishAt      DateTime?
  expiresAt      DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?
  archivedById   String?
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  author     User        @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  archivedBy User?       @relation("AnnouncementArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([status, publishAt])
  @@index([departmentId, status])
}

// How a placement was recorded.
enum PlacementSource {
  // Created with the application being marked SELECTED, in the same
  // transaction (updateApplicationStage).
  APPLICATION
  // Recorded by a department admin for an offer made outside CampusHire.
  MANUAL
}

// A student's placement: the explicit, auditable record that they are placed.
//
// A student is placed while they hold at least one placement with
// `revokedAt IS NULL`. That is the only definition of "placed" in the app
// (features/students/utils/placement-status.ts). Once placed, a student is
// permanently excluded from new drives: the eligibility evaluator checks it
// first and stops.
//
// Rows are history. They are never deleted by the app and never edited: a
// trigger in the migration refuses every change except the one-time
// revocation (revokedAt, revokedById, revokeReason, set together, once),
// which is how a placement recorded by mistake is corrected.
model StudentPlacement {
  id             String          @id @default(cuid())
  studentId      String
  source         PlacementSource
  // The selected application, for APPLICATION placements. At most one
  // placement per application.
  applicationId  String?         @unique
  driveId        String?
  companyName    String
  roleName       String
  packageOffered Decimal?        @db.Decimal(10, 2)
  packageDisplay String?
  placedAt       DateTime
  // Null only for rows backfilled from applications selected before this
  // table existed, where no actor was recorded.
  recordedById   String?
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application DriveApplication? @relation(fields: [applicationId], references: [id], onDelete: NoAction)
  drive       Drive?            @relation(fields: [driveId], references: [id], onDelete: NoAction)
  recordedBy  User?             @relation("PlacementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  revokedBy   User?             @relation("PlacementRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([driveId])
}

// What kind of step a recruitment stage is.
enum RecruitmentStageType {
  APPLICATION
  APTITUDE
  CODING
  GROUP_DISCUSSION
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  MANAGERIAL_INTERVIEW
  PRESENTATION
  ASSESSMENT
  OFFER
  CUSTOM
}

enum PipelineVersionStatus {
  ACTIVE
  SUPERSEDED
}

enum PipelineChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// One version of a department drive's recruitment pipeline.
//
// A version never changes: a change to the pipeline is a new version, and the
// previous one is marked SUPERSEDED (a trigger allows exactly that and nothing
// else). Exactly one version per department drive is ACTIVE (a partial unique
// index). Applications keep pointing at the stages of whatever version they
// were last moved under, so history is never rewritten.
model RecruitmentPipelineVersion {
  id                      String                @id @default(cuid())
  driveDepartmentConfigId String
  version                 Int
  status                  PipelineVersionStatus
  // Why this version exists: initial, direct edit, approved request…
  note                    String?               @db.Text
  createdById             String?
  createdAt               DateTime              @default(now())
  supersededAt            DateTime?

  departmentDrive DriveDepartmentConfig   @relation(fields: [driveDepartmentConfigId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation("PipelineVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  stages          RecruitmentStage[]
  stageEvents     ApplicationStageEvent[]
  requestsBasedOn PipelineChangeRequest[] @relation("PipelineRequestBase")
  requestsResult  PipelineChangeRequest[] @relation("PipelineRequestResult")

  @@unique([driveDepartmentConfigId, version])
}

// A stage of one pipeline version. Immutable (trigger).
model RecruitmentStage {
  id                String               @id @default(cuid())
  pipelineVersionId String
  name              String
  stageType         RecruitmentStageType
  sortOrder         Int
  description       String?              @db.Text
  instructions      String?              @db.Text
  // Whether students see this stage by name on their application.
  visibleToStudents Boolean              @default(true)
  scheduledAt       DateTime?
  location          String?
  // A disabled stage stays in the version but cannot be moved into.
  isEnabled         Boolean              @default(true)

  pipelineVersion  RecruitmentPipelineVersion @relation(fields: [pipelineVersionId], references: [id], onDelete: Cascade)
  applicationsHere DriveApplication[]         @relation("ApplicationCurrentStage")
  eventsFrom       ApplicationStageEvent[]    @relation("StageEventFrom")
  eventsTo         ApplicationStageEvent[]    @relation("StageEventTo")

  @@unique([pipelineVersionId, sortOrder])
}

// One move of one application: from which stage and status to which, under
// which pipeline version, by whom, and why. Append-only (trigger).
model ApplicationStageEvent {
  id                String             @id @default(cuid())
  applicationId     String
  pipelineVersionId String
  fromStageId       String?
  toStageId         String
  fromStatus        ApplicationStatus?
  toStatus          ApplicationStatus
  // Null for the backfill of applications from before pipelines.
  actorId           String?
  note              String?            @db.Text
  createdAt         DateTime           @default(now())

  application     DriveApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  pipelineVersion RecruitmentPipelineVersion @relation(fields: [pipelineVersionId], references: [id], onDelete: NoAction)
  fromStage       RecruitmentStage?          @relation("StageEventFrom", fields: [fromStageId], references: [id], onDelete: NoAction)
  toStage         RecruitmentStage           @relation("StageEventTo", fields: [toStageId], references: [id], onDelete: NoAction)
  actor           User?                      @relation("StageEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

// ============================================================================
// 12 — SETTINGS
// ============================================================================

// The institution's own configuration: one row, held by the Super Admin.
//
// Only settings the application actually honours live here — a stored value
// nothing reads is worse than no setting at all, because it tells a Super
// Admin something is in force when it is not. Each field below names what
// reads it.
model InstitutionSettings {
  // One row. The singleton id makes a second one impossible.
  id                    String    @id @default("institution")
  // Shown wherever the placement office is named to students and admins.
  institutionName       String    @default("CampusHire")
  // The placement year. When `enforceSeasonWindow` is on, a drive date
  // outside it is refused at creation (never retroactively).
  seasonStart           DateTime?
  seasonEnd             DateTime?
  enforceSeasonWindow   Boolean   @default(false)
  // Prefilled into a new drive's eligibility, and used as the default when a
  // drive sets no bar of its own. Defaults only: a drive's own rules win.
  defaultMinCGPA        Float?
  defaultMaxBacklogs    Int?
  // The stages a new master drive starts with (JSON array, as every JSON
  // column here). A drive's own pipeline, once created, is independent.
  defaultPipelineStages String?   @db.Text
  updatedById           String?
  updatedAt             DateTime  @updatedAt

  updatedBy User? @relation("InstitutionSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// One department's own defaults, set by its admins.
//
// Defaults only. They are read when a form is first opened for a drive that
// is not yet published; they never change a published drive, never bypass the
// Super Admin's field permissions, and never reach another department — the
// department comes from the session on every read and write.
model DepartmentSettings {
  departmentId         String   @id
  // Drive logistics defaults (DriveDepartmentConfig.venue, reportingTime,
  // coordinatorName, coordinatorPhone, coordinatorEmail, specialInstructions).
  defaultVenue         String?
  defaultReportingTime String?
  coordinatorName      String?
  coordinatorPhone     String?
  coordinatorEmail     String?
  defaultInstructions  String?  @db.Text
  // Student management: the expected passout year prefilled when a student
  // is added by hand.
  defaultPassoutYear   Int?
  updatedById          String?
  updatedAt            DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation("DepartmentSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// A department admin's proposed change to a published drive's pipeline,
// reviewed by the Super Admin. At most one PENDING per department drive
// (partial unique index); a reviewer can never be the requester (CHECK).
model PipelineChangeRequest {
  id                      String               @id @default(cuid())
  driveDepartmentConfigId String
  // The active version when the change was proposed. Approval is refused if
  // the pipeline has moved on since.
  baseVersionId           String
  // The proposed stages, as a JSON array (TEXT, as every JSON column here).
  proposedStages          String               @db.Text
  reason                  String               @db.Text
  status                  PipelineChangeStatus @default(PENDING)
  requestedById           String
  createdAt               DateTime             @default(now())
  reviewedById            String?
  reviewedAt              DateTime?
  reviewNote              String?              @db.Text
  // The version an approval created.
  resultingVersionId      String?

  departmentDrive  DriveDepartmentConfig       @relation(fields: [driveDepartmentConfigId], references: [id], onDelete: Cascade)
  baseVersion      RecruitmentPipelineVersion  @relation("PipelineRequestBase", fields: [baseVersionId], references: [id], onDelete: NoAction)
  resultingVersion RecruitmentPipelineVersion? @relation("PipelineRequestResult", fields: [resultingVersionId], references: [id], onDelete: NoAction)
  requestedBy      User                        @relation("PipelineRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy       User?                       @relation("PipelineReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([driveDepartmentConfigId])
  @@index([status])
}
